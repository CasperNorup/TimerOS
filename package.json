{
  "name": "timeros",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.1.3 --port 1420 --strictPort",
    "dev:windows": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "node --disable-warning=ExperimentalWarning --test tests/timer.test.ts",
    "test:windows": "node tests/windows-smoke.mjs"
  },
  "dependencies": {
    "lottie-web": "5.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
