{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimerOS",
  "version": "0.5.4",
  "identifier": "com.caspernorup.timeros",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.2.3:1420",
    "beforeBuildCommand": "npm run build:windows",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TimerOS",
        "width": 490,
        "height": 480,
        "minWidth": 340,
        "minHeight": 390,
        "center": true,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows",
        "backgroundColor": "#080f21",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; object-src 'none'; base-uri 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.2.3:1420"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/timeros-transparent.ico"],
    "targets": ["nsis"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/timeros-transparent.ico",
        "uninstallerIcon": "icons/timeros-transparent.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
